# Copy to .env and adjust before: docker compose up --build
# Render: set secrets in the Render dashboard (Blueprint can auto-generate JWT_SECRET_KEY)

JWT_SECRET_KEY=replace-with-long-random-string-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Public URL for QR codes / deploy links (change when deployed)
GATEWAY_PUBLIC_URL=http://localhost:8080

# Used by user-service inside Docker Compose
DATABASE_URL=postgresql+asyncpg://platform:platform@postgres:5432/user_db
