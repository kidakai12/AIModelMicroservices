# Copy to .env.supabase for: docker compose -f docker-compose.supabase.yml --env-file .env.supabase up --build
#
# Requires: supabase start  (Postgres on localhost:54322)

JWT_SECRET_KEY=dev-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false

# From host machine (uvicorn local): use 127.0.0.1
# From Docker (user-service container): use host.docker.internal
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:54322/postgres

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:54323

# Optional Supabase REST API (for future frontend / Supabase client — not used by user-service today)
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=<run: supabase status>
